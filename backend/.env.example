# =============================================================================
# WorkNest Backend — Environment Variables (Example)
# =============================================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# This file contains variable names only — NO real credentials.
# =============================================================================

# Server
PORT=5000
NODE_ENV=development

# Database (Neon PostgreSQL)
DATABASE_URL=

# =============================================================================
# Authentication & Payments (to be used later)
# =============================================================================
JWT_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=