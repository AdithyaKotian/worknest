# =============================================================================
# WorkNest Backend — Git Ignore
# =============================================================================

# Dependencies
node_modules/

# Build output
dist/

# Environment variables (contains secrets — NEVER commit)
.env
.env.*
!.env.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# OS files
.DS_Store
Thumbs.db

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Prisma
prisma/*.db
prisma/*.db-journal